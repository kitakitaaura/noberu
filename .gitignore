# macOS
.DS_Store

# Editor / tooling noise
node_modules/
*.log

# The unsplit BoxedWine root filesystem is kept outside this tree
# (~/Documents/noberu-assets/boxedwine.zip); only the parts under
# boxedwine-runtime/root/ are committed. See tools/split-root-zip.mjs.
boxedwine.zip

# Wrangler's local cache (account id, temp files)
.wrangler/

# Dev-only link to a local copy of DDLC (see renpy-runtime/README.md)
renpy-runtime/testddlc
renpy-runtime/testddlc_filelist.txt

# Generated on the staged copy by tools/offline-manifest.mjs (tools/stage-deploy.sh)
offline.json

# The reading tools' dictionary, built by tools/build-dict.mjs from
# jmdict-simplified's JSON (kept in ~/Documents/noberu-assets/dict-src);
# tools/stage-deploy.sh builds it when it is missing.
dict/
